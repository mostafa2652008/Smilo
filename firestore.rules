rules_version = '2';

// انسخ هذا الملف إلى Firebase Console → Firestore Database → Rules
// (أو استخدم Firebase CLI: firebase deploy --only firestore:rules)

service cloud.firestore {
  match /databases/{database}/documents {

    // منتجات المتجر: القراءة عامة للجميع (الموقع العام يعرضها)،
    // والكتابة (إضافة/تعديل/حذف) مسموحة فقط لمستخدم مسجّل دخول
    // (أي حساب أدمن تُنشئه يدويًا في Firebase Authentication).
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
